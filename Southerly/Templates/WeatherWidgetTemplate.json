{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.6",
  "header": { "text": "${suburb != '' ? suburb : 'Southerly'}", "iconUrl": "${iconUrl}" },
  "backgroundImage": { "url": "${backgroundImageUrl}", "fillMode": "cover", "horizontalAlignment": "center", "verticalAlignment": "center" },

  "body": [
    {
      "type": "ColumnSet",
      "$comment": "Medium: tabs",
      "$when": "${hasData && !editing && error == '' && $host.widgetSize == 'medium'}",
      "columns": [
        { "type": "Column", "width": "auto", "selectAction": { "type": "Action.Execute", "verb": "showNow", "associatedInputs": "none", "tooltip": "Current conditions" },
          "items": [{ "type": "TextBlock", "text": "Now", "weight": "${page == 0 ? 'bolder' : 'default'}", "color": "${page == 0 ? 'accent' : 'default'}", "isSubtle": "${page != 0}", "wrap": false }] },
        { "type": "Column", "width": "auto", "spacing": "large", "selectAction": { "type": "Action.Execute", "verb": "showHourly", "associatedInputs": "none", "tooltip": "Next 8 hours" },
          "items": [{ "type": "TextBlock", "text": "Hourly", "weight": "${page == 2 ? 'bolder' : 'default'}", "color": "${page == 2 ? 'accent' : 'default'}", "isSubtle": "${page != 2}", "wrap": false }] },
        { "type": "Column", "width": "auto", "spacing": "large", "selectAction": { "type": "Action.Execute", "verb": "showDaily", "associatedInputs": "none", "tooltip": "Next 5 days" },
          "items": [{ "type": "TextBlock", "text": "Daily", "weight": "${page == 1 ? 'bolder' : 'default'}", "color": "${page == 1 ? 'accent' : 'default'}", "isSubtle": "${page != 1}", "wrap": false }] },
        { "type": "Column", "width": "stretch", "selectAction": { "type": "Action.Execute", "verb": "editLocation", "associatedInputs": "none", "tooltip": "Change location" },
          "items": [{ "type": "TextBlock", "text": "📍 Change", "isSubtle": true, "size": "small", "horizontalAlignment": "right", "wrap": false }] }
      ]
    },

    {
      "type": "Container",
      "$comment": "Search box (first run, Change, Customize widget, or an error)",
      "$when": "${(!hasData || editing || error != '') && !hasMatches}",
      "items": [
        { "type": "TextBlock", "text": "Weather from the Bureau of Meteorology", "weight": "bolder", "wrap": true, "$when": "${!hasData && $host.widgetSize != 'small'}" },
        { "type": "TextBlock", "text": "Enter a suburb or postcode, e.g. Burwood NSW or 2134.", "isSubtle": true, "spacing": "none", "wrap": true, "$when": "${!hasData && $host.widgetSize != 'small'}" },
        {
          "type": "ColumnSet",
          "spacing": "small",
          "columns": [
            { "type": "Column", "width": "stretch", "verticalContentAlignment": "center",
              "items": [{ "type": "Input.Text", "id": "suburb", "placeholder": "${$host.widgetSize == 'small' ? 'Suburb or postcode' : 'Suburb, state or postcode'}", "value": "${suburb}" }] },
            { "type": "Column", "width": "auto", "verticalContentAlignment": "center",
              "items": [{ "type": "ActionSet", "actions": [
                { "type": "Action.Execute", "title": "Go", "verb": "setLocation", "style": "positive" },
                { "type": "Action.Execute", "title": "✕", "tooltip": "Cancel", "verb": "cancelEdit", "associatedInputs": "none", "$when": "${editing && error == ''}" }
              ] }] }
          ]
        },
        { "type": "ActionSet", "$when": "${$host.widgetSize != 'small'}",
          "actions": [{ "type": "Action.Execute", "title": "📍 Use my location", "verb": "useMyLocation", "associatedInputs": "none" }] },
        { "type": "TextBlock", "text": "⚠ ${editError != '' ? editError : error}", "color": "attention", "weight": "bolder", "size": "small", "wrap": true, "maxLines": 2, "$when": "${editError != '' || error != ''}" }
      ]
    },

    {
      "type": "Container",
      "$comment": "Several places matched (medium, large)",
      "$when": "${hasMatches && $host.widgetSize != 'small'}",
      "items": [
        { "type": "TextBlock", "text": "Which one did you mean?", "weight": "bolder", "wrap": true },
        { "type": "Input.ChoiceSet", "id": "pick", "style": "expanded", "value": "${matches[0].value}", "choices": [{ "$data": "${matches}", "title": "${title}", "value": "${value}" }] },
        { "type": "ActionSet", "actions": [
          { "type": "Action.Execute", "title": "Use this", "verb": "pickLocation", "style": "positive" },
          { "type": "Action.Execute", "title": "Back", "verb": "backToSearch", "associatedInputs": "none" }
        ] }
      ]
    },

    {
      "type": "Container",
      "$comment": "Several places matched (small)",
      "$when": "${hasMatches && $host.widgetSize == 'small'}",
      "items": [
        { "type": "TextBlock", "text": "Which one did you mean?", "size": "small", "isSubtle": true, "wrap": false },
        {
          "type": "ColumnSet",
          "spacing": "small",
          "columns": [
            { "type": "Column", "width": "stretch", "verticalContentAlignment": "center",
              "items": [{ "type": "Input.ChoiceSet", "id": "pick", "style": "compact", "value": "${matches[0].value}", "choices": [{ "$data": "${matches}", "title": "${title}", "value": "${value}" }] }] },
            { "type": "Column", "width": "auto", "verticalContentAlignment": "center",
              "items": [{ "type": "ActionSet", "actions": [
                { "type": "Action.Execute", "title": "Use", "verb": "pickLocation", "style": "positive" },
                { "type": "Action.Execute", "title": "✕", "tooltip": "Back", "verb": "backToSearch", "associatedInputs": "none" }
              ] }] }
          ]
        }
      ]
    },

    {
      "type": "Container",
      "$comment": "Small: everything on one screen; a tap opens the BOM forecast",
      "$when": "${hasData && !editing && error == '' && $host.widgetSize == 'small'}",
      "selectAction": { "type": "Action.OpenUrl", "url": "${bomUrl}", "tooltip": "Open the full forecast on bom.gov.au" },
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            { "type": "Column", "width": "auto", "verticalContentAlignment": "center",
              "items": [{ "type": "Image", "url": "${iconUrl}", "width": "48px", "height": "48px", "altText": "${summary}" }] },
            { "type": "Column", "width": "auto", "verticalContentAlignment": "center",
              "items": [
                { "type": "TextBlock", "text": "${temperature}°", "size": "extraLarge", "weight": "bolder", "wrap": false },
                { "type": "TextBlock", "text": "Feels ${feelsLike}°", "isSubtle": true, "size": "small", "spacing": "none", "wrap": false, "$when": "${feelsLike != ''}" }
              ] },
            { "type": "Column", "width": "stretch", "verticalContentAlignment": "center",
              "items": [
                { "type": "TextBlock", "text": "${summary}", "weight": "bolder", "horizontalAlignment": "right", "wrap": false, "$when": "${summary != ''}" },
                { "type": "TextBlock", "text": "H ${todayMax}°${todayMin != '' ? ' · L ' + todayMin + '°' : ''}", "isSubtle": true, "size": "small", "horizontalAlignment": "right", "spacing": "none", "wrap": false, "$when": "${todayMax != ''}" },
                { "type": "TextBlock", "text": "${todayRain} chance of rain", "color": "accent", "size": "small", "horizontalAlignment": "right", "spacing": "none", "wrap": false, "$when": "${todayRain != ''}" }
              ] }
          ]
        },
        { "type": "ColumnSet", "$data": "${warnings}", "$when": "${$index == 0}", "spacing": "small",
          "$comment": "The most important warning, opening its page, and how many more there are",
          "selectAction": { "type": "Action.OpenUrl", "url": "${url}", "tooltip": "${title}" },
          "columns": [
            { "type": "Column", "width": "stretch", "items": [{ "type": "TextBlock", "text": "⚠ ${label}", "color": "${major ? 'attention' : 'warning'}", "weight": "bolder", "size": "small", "wrap": false }] },
            { "type": "Column", "width": "auto", "$when": "${count($root.warnings) > 1}",
              "items": [{ "type": "TextBlock", "text": "+${count($root.warnings) - 1}", "color": "${major ? 'attention' : 'warning'}", "size": "small", "wrap": false }] }
          ] }
      ]
    },

    {
      "type": "Container",
      "$comment": "Medium Now page and the top of Large: conditions, stats and today's notes",
      "$when": "${hasData && !editing && error == '' && (($host.widgetSize == 'medium' && page == 0) || $host.widgetSize == 'large')}",
      "separator": "${$host.widgetSize == 'medium'}",
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            { "type": "Column", "width": "auto", "verticalContentAlignment": "center",
              "items": [{ "type": "Image", "url": "${iconUrl}", "width": "64px", "height": "64px", "altText": "${summary}" }] },
            { "type": "Column", "width": "stretch", "verticalContentAlignment": "center",
              "items": [
                { "type": "TextBlock", "text": "${temperature}°", "size": "extraLarge", "weight": "bolder", "wrap": false },
                { "type": "TextBlock", "text": "${summary}", "weight": "bolder", "spacing": "none", "wrap": false, "$when": "${summary != ''}" },
                { "type": "TextBlock", "text": "Feels like ${feelsLike}°", "isSubtle": true, "size": "small", "spacing": "none", "wrap": false, "$when": "${feelsLike != ''}" }
              ] },
            { "type": "Column", "width": "auto", "verticalContentAlignment": "center",
              "items": [
                { "type": "TextBlock", "text": "H ${todayMax}°", "weight": "bolder", "horizontalAlignment": "right", "wrap": false, "$when": "${todayMax != ''}" },
                { "type": "TextBlock", "text": "L ${todayMin}°", "isSubtle": true, "horizontalAlignment": "right", "spacing": "none", "wrap": false, "$when": "${todayMin != ''}" }
              ] }
          ]
        },
        {
          "type": "ColumnSet",
          "spacing": "small",
          "columns": [
            { "type": "Column", "width": "stretch", "$when": "${humidity != ''}",
              "items": [
                { "type": "TextBlock", "text": "${humidity}", "weight": "bolder", "wrap": false },
                { "type": "TextBlock", "text": "Humidity", "isSubtle": true, "size": "small", "spacing": "none", "wrap": false }
              ] },
            { "type": "Column", "width": "stretch", "$when": "${wind != ''}",
              "items": [
                { "type": "TextBlock", "text": "${wind}", "weight": "bolder", "wrap": false },
                { "type": "TextBlock", "text": "Wind", "isSubtle": true, "size": "small", "spacing": "none", "wrap": false }
              ] },
            { "type": "Column", "width": "stretch", "$when": "${rain != ''}",
              "items": [
                { "type": "TextBlock", "text": "${rain}", "weight": "bolder", "wrap": false },
                { "type": "TextBlock", "text": "Since 9am", "isSubtle": true, "size": "small", "spacing": "none", "wrap": false }
              ] }
          ]
        },
        { "type": "TextBlock", "$data": "${notes}", "$when": "${$index == 0 || $host.widgetSize == 'large'}", "text": "${text}", "color": "${color}", "size": "small", "spacing": "${$index == 0 ? 'small' : 'none'}", "wrap": false }
      ]
    },

    {
      "type": "ColumnSet",
      "$comment": "Large: next five hours",
      "$when": "${hasData && !editing && error == '' && $host.widgetSize == 'large'}",
      "spacing": "small",
      "separator": true,
      "columns": [
        { "type": "Column", "$data": "${hourlyStrip}", "width": "stretch",
          "items": [
            { "type": "TextBlock", "text": "${timeLabel}", "isSubtle": true, "size": "small", "horizontalAlignment": "center", "wrap": false },
            { "type": "Image", "url": "${iconUrl}", "width": "24px", "height": "24px", "horizontalAlignment": "center", "spacing": "none", "altText": "Weather" },
            { "type": "TextBlock", "text": "${temp}°", "weight": "bolder", "size": "small", "horizontalAlignment": "center", "spacing": "none", "wrap": false },
            { "type": "TextBlock", "text": "${rainChance}", "color": "accent", "size": "small", "horizontalAlignment": "center", "spacing": "none", "wrap": false, "$when": "${rainChance != ''}" }
          ] }
      ]
    },

    {
      "type": "Container",
      "$comment": "Medium Hourly tab",
      "$when": "${hasData && !editing && error == '' && $host.widgetSize == 'medium' && page == 2}",
      "separator": true,
      "items": [
        {
          "type": "ColumnSet",
          "$data": "${hourlyForecasts}",
          "spacing": "none",
          "columns": [
            { "type": "Column", "width": "48px", "verticalContentAlignment": "center", "items": [{ "type": "TextBlock", "text": "${timeLabel}", "weight": "bolder", "size": "small", "wrap": false }] },
            { "type": "Column", "width": "32px", "verticalContentAlignment": "center", "items": [{ "type": "Image", "url": "${iconUrl}", "width": "26px", "height": "26px", "altText": "Weather" }] },
            { "type": "Column", "width": "40px", "verticalContentAlignment": "center", "items": [{ "type": "TextBlock", "text": "${temp}°", "weight": "bolder", "size": "small", "wrap": false }] },
            { "type": "Column", "width": "stretch", "verticalContentAlignment": "center", "items": [{ "type": "TextBlock", "text": "${wind}", "isSubtle": true, "size": "small", "wrap": false }] },
            { "type": "Column", "width": "auto", "verticalContentAlignment": "center", "items": [{ "type": "TextBlock", "text": "${rainChance}", "size": "small", "color": "accent", "wrap": false }] }
          ]
        }
      ]
    },

    {
      "type": "Container",
      "$comment": "Medium Daily tab and the bottom of Large: five days",
      "$when": "${hasData && !editing && error == '' && (($host.widgetSize == 'medium' && page == 1) || $host.widgetSize == 'large')}",
      "separator": true,
      "spacing": "${$host.widgetSize == 'large' ? 'small' : 'default'}",
      "items": [
        {
          "type": "ColumnSet",
          "$data": "${dailyForecasts}",
          "spacing": "${$host.widgetSize == 'large' ? 'none' : 'small'}",
          "columns": [
            { "type": "Column", "width": "48px", "verticalContentAlignment": "center", "items": [{ "type": "TextBlock", "text": "${dayLabel}", "weight": "bolder", "size": "small", "wrap": false }] },
            { "type": "Column", "width": "28px", "verticalContentAlignment": "center", "items": [{ "type": "Image", "url": "${iconUrl}", "width": "22px", "height": "22px", "altText": "${desc}" }] },
            { "type": "Column", "width": "stretch", "verticalContentAlignment": "center", "items": [{ "type": "TextBlock", "text": "${desc}", "isSubtle": true, "size": "small", "wrap": false }] },
            { "type": "Column", "width": "auto", "verticalContentAlignment": "center", "items": [{ "type": "TextBlock", "text": "${rainChance}", "size": "small", "color": "accent", "wrap": false }] },
            { "type": "Column", "width": "32px", "verticalContentAlignment": "center", "items": [{ "type": "TextBlock", "text": "${maxTemp}°", "weight": "bolder", "size": "small", "horizontalAlignment": "right", "wrap": false, "$when": "${maxTemp != ''}" }] },
            { "type": "Column", "width": "32px", "verticalContentAlignment": "center", "items": [{ "type": "TextBlock", "text": "${minTemp}°", "isSubtle": true, "size": "small", "horizontalAlignment": "right", "wrap": false, "$when": "${minTemp != ''}" }] }
          ]
        }
      ]
    },

    {
      "type": "Carousel",
      "$comment": "Medium Now page and Large: warnings, one per page to swipe through; each opens its own page on bom.gov.au",
      "$when": "${hasData && !editing && error == '' && hasWarnings && (($host.widgetSize == 'medium' && page == 0) || $host.widgetSize == 'large')}",
      "spacing": "small",
      "pages": [
        { "type": "CarouselPage", "$data": "${warnings}", "style": "${major ? 'attention' : 'warning'}",
          "selectAction": { "type": "Action.OpenUrl", "url": "${url}", "tooltip": "${title}" },
          "items": [{ "type": "ColumnSet", "columns": [
            { "type": "Column", "width": "stretch", "verticalContentAlignment": "center",
              "items": [{ "type": "TextBlock", "text": "⚠ ${label}", "weight": "bolder", "size": "small", "wrap": false }] },
            { "type": "Column", "width": "auto", "verticalContentAlignment": "center", "$when": "${count($root.warnings) > 1}",
              "items": [{ "type": "TextBlock", "text": "${$index + 1}/${count($root.warnings)}", "size": "small", "isSubtle": true, "wrap": false }] }
          ] }] }
      ]
    },

    {
      "type": "Container",
      "$comment": "Medium Now page and Large: the observation source",
      "$when": "${hasData && !editing && error == '' && (($host.widgetSize == 'medium' && page == 0) || $host.widgetSize == 'large')}",
      "items": [
        {
          "type": "ColumnSet",
          "spacing": "small",
          "columns": [
            { "type": "Column", "width": "stretch", "verticalContentAlignment": "center",
              "selectAction": { "type": "Action.OpenUrl", "url": "${bomUrl}", "tooltip": "Open the full forecast on bom.gov.au" },
              "items": [{ "type": "TextBlock", "text": "${stationLine}", "isSubtle": true, "size": "small", "wrap": false }] },
            { "type": "Column", "width": "auto", "verticalContentAlignment": "center", "$when": "${$host.widgetSize == 'large'}",
              "selectAction": { "type": "Action.Execute", "verb": "editLocation", "associatedInputs": "none", "tooltip": "Change location" },
              "items": [{ "type": "TextBlock", "text": "📍 Change", "isSubtle": true, "size": "small", "wrap": false }] }
          ]
        }
      ]
    }
  ]
}
