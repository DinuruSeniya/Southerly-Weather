<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.28000.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.28000.87</WindowsSdkPackageVersion>
    <!-- Windows 11 26H2. Bump this and the manifest's MinVersion with each new Windows release. -->
    <TargetPlatformMinVersion>10.0.26300.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.26300.0</SupportedOSPlatformVersion>
    <RootNamespace>Southerly</RootNamespace>
    <!-- ARM64 is the default; build x64 with: dotnet build -p:Platform=x64 -->
    <Platforms>ARM64;x64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">ARM64</Platform>
    <RuntimeIdentifier>win-$(Platform.ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>false</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <SdkSupportedTargetPlatformVersion Include="10.0.28000.0" />
  </ItemGroup>

  <!-- Package content is copied into the build output so the output folder can be
       registered directly with Add-AppxPackage -Register (no VS deploy needed). -->
  <ItemGroup>
    <Content Include="Assets\**\*;ProviderAssets\**\*;Templates\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="2.0.5" />
  </ItemGroup>

  <Import Project="..\WidgetHelper\WidgetHelper.projitems" Label="Shared" />
</Project>
